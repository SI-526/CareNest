{
  "name": "carenest-db-tests",
  "private": true,
  "type": "module",
  "description": "Local-only Supabase tooling and authorization tests for CareNest. Kept out of the repo root so Vercel keeps serving the site as static files.",
  "scripts": {
    "db:start": "supabase start --workdir ..",
    "db:reset": "supabase db reset --workdir ..",
    "db:lint": "supabase db lint --workdir .. --level warning",
    "db:stop": "supabase stop --workdir ..",
    "test:rls": "node --test rls.test.mjs"
  },
  "devDependencies": {
    "@supabase/supabase-js": "2.117.2",
    "supabase": "2.118.0"
  }
}
